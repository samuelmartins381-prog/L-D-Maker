{
  "name": "@ldm/studio",
  "version": "0.1.0",
  "private": true,
  "description": "L-D-Maker Studio",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "start": "electron .",
    "check:svelte": "svelte-check --tsgo --tsconfig ./tsconfig.svelte-check.json --fail-on-warnings"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@ldm/builder": "workspace:*",
    "@ldm/generator": "workspace:*",
    "@ldm/schema": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "electron": "43.7.7",
    "electron-builder": "26.17.0",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "8.3.4"
  },
  "author": "Sam"
}
